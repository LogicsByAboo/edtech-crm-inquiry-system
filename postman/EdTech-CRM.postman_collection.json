              "var jsonData = pm.response.json();",
              "pm.test(\"Returns correct admin profile\", function () {",
              "    pm.expect(jsonData.email).to.eql(pm.collectionVariables.get(\"adminEmail\"));",
              "    pm.expect(jsonData.name).to.be.a(\"string\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },

              "var jsonData = pm.response.json();",
              "pm.test(\"Error message is safe\", function () {",
              "    pm.expect(jsonData.message).to.eql(\"Invalid email or password\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {

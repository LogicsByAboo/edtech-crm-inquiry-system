{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "EdTech CRM & Inquiry System API Suite",
    "description": "Comprehensive automated API test collection for EdTech CRM & Inquiry System covering Authentication, Public Submissions, Inquiries Management, Criteria Filtering, Status Updates, and Centralized CORS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@edtech.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "AdminSecurePassword123!",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "inquiryId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. CORS Preflight - OPTIONS /api/inquiries",
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:5173",
            "type": "text"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "POST",
            "type": "text"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "Content-Type,Authorization",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inquiries",
          "host": ["{{baseUrl}}"],
          "path": ["inquiries"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK for allowed origin\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"CORS headers are correctly returned\", function () {",
              "    pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:5173\");",
              "    pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"POST\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02. Public Inquiry Submission - 201 Created",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"9876543210\",\n  \"userType\": \"Parent\",\n  \"category\": \"Scholarship\",\n  \"message\": \"Interested in high-school scholarship criteria for the upcoming academic cycle.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/inquiries",
          "host": ["{{baseUrl}}"],
          "path": ["inquiries"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Inquiry created with status New\", function () {",
              "    pm.expect(jsonData.id).to.be.a(\"number\");",
              "    pm.expect(jsonData.status).to.eql(\"New\");",
              "    pm.expect(jsonData.name).to.eql(\"Jane Doe\");",
              "    pm.collectionVariables.set(\"inquiryId\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03. Public Inquiry Submission - Validation Error (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"invalid-email-address\",\n  \"phone\": \"\",\n  \"userType\": \"Parent\",\n  \"category\": \"Scholarship\",\n  \"message\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/inquiries",
          "host": ["{{baseUrl}}"],
          "path": ["inquiries"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Validation details provided\", function () {",
              "    pm.expect(jsonData.message).to.eql(\"Validation failed\");",
              "    pm.expect(jsonData.details).to.have.property(\"email\");",
              "    pm.expect(jsonData.details).to.have.property(\"name\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04. Admin Login - Success (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Returns JWT and safe profile without password hash\", function () {",
              "    pm.expect(jsonData.accessToken).to.be.a(\"string\");",
              "    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");",
              "    pm.expect(jsonData.admin.email).to.eql(pm.collectionVariables.get(\"adminEmail\"));",
              "    pm.expect(jsonData.admin.passwordHash).to.be.undefined;",
              "    pm.collectionVariables.set(\"jwtToken\", jsonData.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05. Admin Login - Invalid Password (401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",

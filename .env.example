# Root .env for local development. Never commit real secrets.
# Neon PostgreSQL URI. URL-encode special characters in username/password if required.
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require

# Optional alternative if not using DATABASE_URL
# DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DATABASE?sslmode=require
# DB_USERNAME=YOUR_USERNAME
# DB_PASSWORD=YOUR_PASSWORD

# Use a unique random secret in production (at least 32 characters).
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=3600000

# Exact frontend origin(s), comma-separated. Local Vite default:
FRONTEND_ORIGINS=http://localhost:5173
SERVER_PORT=8080

# Initial administrator bootstrap (only creates the account if email does not exist)
ADMIN_NAME=Administrator
ADMIN_EMAIL=aboobucker2003@gmail.com
ADMIN_PASSWORD=admin123

# Used by Vite only; never put backend secrets here.
VITE_API_BASE_URL=http://localhost:8080/api
